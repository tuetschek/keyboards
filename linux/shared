[main]
# CapsLock acts as Escape when tapped, but activates the 'nav' layer when held
capslock = overload(nav, esc)

[nav]
left = home
right = end
up = pageup
down = pagedown
delete = insert
tab = capslock
space = compose

# Number row -> F1-F10; Dvorak [ and ] (physical - and =) -> F11, F12
1 = f1
2 = f2
3 = f3
4 = f4
5 = f5
6 = f6
7 = f7
8 = f8
9 = f9
0 = f10
minus = f11
equal = f12
